<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_us_tax_exemption_verification_list" model="ir.ui.view">
        <field name="name">us.tax.exemption.verification.list</field>
        <field name="model">us.tax.exemption.verification</field>
        <field name="arch" type="xml">
            <list
                decoration-success="result == 'verified'"
                decoration-danger="result == 'not_found'"
                decoration-muted="result == 'inconclusive'"
            >
                <field name="verified_on" />
                <field name="partner_id" />
                <field name="state_id" />
                <field name="verifier_id" />
                <field name="mode" />
                <field name="result" />
                <field name="reference" />
                <field name="detail" />
                <field name="verified_by" />
            </list>
        </field>
    </record>

    <record id="view_us_tax_exemption_verification_form" model="ir.ui.view">
        <field name="name">us.tax.exemption.verification.form</field>
        <field name="model">us.tax.exemption.verification</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="exemption_id" />
                            <field name="partner_id" />
                            <field name="state_id" />
                            <field name="result" />
                            <field name="reference" />
                        </group>
                        <group>
                            <field name="verifier_id" />
                            <field name="mode" />
                            <field name="verified_by" />
                            <field name="verified_on" />
                            <field
                                name="company_id"
                                groups="base.group_multi_company"
                            />
                        </group>
                    </group>
                    <group string="Outcome">
                        <field name="detail" nolabel="1" />
                    </group>
                    <group string="Evidence">
                        <field name="evidence" filename="evidence_filename" />
                        <field name="evidence_filename" invisible="1" />
                        <field name="payload" invisible="not payload" nolabel="1" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_us_tax_exemption_verification" model="ir.actions.act_window">
        <field name="name">Verifications</field>
        <field name="res_model">us.tax.exemption.verification</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
