<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_us_tax_exemption_verifier_list" model="ir.ui.view">
        <field name="name">us.tax.exemption.verifier.list</field>
        <field name="model">us.tax.exemption.verifier</field>
        <field name="arch" type="xml">
            <list>
                <field name="priority" />
                <field name="name" />
                <field name="code" />
                <field name="mode" />
                <field name="state_ids" widget="many2many_tags" />
                <field name="active" widget="boolean_toggle" />
            </list>
        </field>
    </record>

    <record id="view_us_tax_exemption_verifier_form" model="ir.ui.view">
        <field name="name">us.tax.exemption.verifier.form</field>
        <field name="model">us.tax.exemption.verifier</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name" />
                            <field name="code" />
                            <field name="mode" />
                            <field name="active" />
                        </group>
                        <group>
                            <field name="priority" />
                            <field name="timeout" />
                            <field name="api_key_param" />
                        </group>
                    </group>
                    <group string="States Covered">
                        <field
                            name="state_ids"
                            widget="many2many_tags"
                            nolabel="1"
                            placeholder="Leave empty for every state"
                        />
                    </group>
                    <group string="Notes">
                        <field name="description" nolabel="1" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_us_tax_exemption_verifier" model="ir.actions.act_window">
        <field name="name">Certificate Verifiers</field>
        <field name="res_model">us.tax.exemption.verifier</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
