<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_us_tax_exemption_validity_list" model="ir.ui.view">
        <field name="name">us.tax.exemption.validity.list</field>
        <field name="model">us.tax.exemption.validity</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="state_id" placeholder="Any state" />
                <field name="reason_id" placeholder="Any reason" />
                <field name="validity_years" invisible="never_expires" />
                <field name="never_expires" />
                <field name="notes" optional="hide" />
                <field name="active" widget="boolean_toggle" optional="hide" />
            </list>
        </field>
    </record>

    <record id="action_us_tax_exemption_validity" model="ir.actions.act_window">
        <field name="name">Certificate Validity</field>
        <field name="res_model">us.tax.exemption.validity</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add a validity rule</p>
            <p>
                Certificates run for the company default unless a rule says
                otherwise. Add a rule where a state or an exemption reason
                carries its own term — or none at all.
            </p>
        </field>
    </record>
</odoo>
