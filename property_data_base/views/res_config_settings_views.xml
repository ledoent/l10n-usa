<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.property.data</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app
                    string="Property Data"
                    name="property_data_base"
                    logo="/property_data_base/static/description/icon.png"
                >
                    <block title="Data Sources" name="property_data_sources">
                        <setting
                            string="Sources"
                            help="Configure and prioritise the providers used to enrich properties."
                        >
                            <button
                                name="action_open_property_sources"
                                type="object"
                                string="Configure Sources"
                                class="btn-link"
                                icon="oi-arrow-right"
                            />
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
