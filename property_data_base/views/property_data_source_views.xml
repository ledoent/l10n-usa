<odoo>
    <record id="view_property_data_source_list" model="ir.ui.view">
        <field name="name">property.data.source.list</field>
        <field name="model">property.data.source</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle" />
                <field name="name" />
                <field name="provider" />
                <field name="capability_display" />
                <field name="cache_ttl_days" />
                <field name="active" widget="boolean_toggle" />
            </list>
        </field>
    </record>

    <record id="view_property_data_source_form" model="ir.ui.view">
        <field name="name">property.data.source.form</field>
        <field name="model">property.data.source</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="e.g. US Census" />
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="provider" />
                            <field name="sequence" />
                            <field name="active" />
                        </group>
                        <group>
                            <field name="capability_display" />
                            <field name="cache_ttl_days" />
                            <field name="request_timeout" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_property_data_source" model="ir.actions.act_window">
        <field name="name">Data Sources</field>
        <field name="res_model">property.data.source</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add a property data source
            </p>
            <p>
                Sources are tried in priority order. Put free providers (Census,
                county GIS) above paid fallbacks (Realie) to minimise cost.
            </p>
        </field>
    </record>
</odoo>
