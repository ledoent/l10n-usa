<odoo noupdate="1">
    <record id="module_category_property_data" model="ir.module.category">
        <field name="name">Property Data</field>
        <field name="sequence">90</field>
    </record>

    <record id="group_property_data_user" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="module_category_property_data" />
    </record>

    <record id="group_property_data_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id" ref="module_category_property_data" />
        <field name="implied_ids" eval="[(4, ref('group_property_data_user'))]" />
        <field name="users" eval="[(4, ref('base.user_admin'))]" />
    </record>
</odoo>
