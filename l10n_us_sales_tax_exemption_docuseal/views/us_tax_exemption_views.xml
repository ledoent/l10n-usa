<odoo>
    <record id="view_us_tax_exemption_form" model="ir.ui.view">
        <field name="name">us.tax.exemption.form.docuseal</field>
        <field name="model">us.tax.exemption</field>
        <field
            name="inherit_id"
            ref="l10n_us_sales_tax_exemption.view_us_tax_exemption_form"
        />
        <field name="arch" type="xml">
            <field name="expiry_date" position="after">
                <field
                    name="docuseal_submission_id"
                    invisible="not docuseal_submission_id"
                />
                <field
                    name="docuseal_sign_url"
                    widget="url"
                    invisible="not docuseal_sign_url"
                />
            </field>
        </field>
    </record>
</odoo>
