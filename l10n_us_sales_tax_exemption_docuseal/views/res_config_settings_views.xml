<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.form.docuseal</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app string="US Sales Tax" name="l10n_us_sales_tax_exemption_docuseal">
                    <block title="DocuSeal E-Signature">
                        <setting
                            string="Connection"
                            help="Where exemption certificates are sent for signature."
                        >
                            <div class="content-group">
                                <div class="row">
                                    <label
                                        for="docuseal_url"
                                        class="col-lg-4 o_light_label"
                                    />
                                    <field name="docuseal_url" />
                                </div>
                                <div class="row">
                                    <label
                                        for="docuseal_api_token"
                                        class="col-lg-4 o_light_label"
                                    />
                                    <field name="docuseal_api_token" password="True" />
                                </div>
                                <div class="row">
                                    <label
                                        for="docuseal_template_id"
                                        class="col-lg-4 o_light_label"
                                    />
                                    <field name="docuseal_template_id" />
                                </div>
                                <div class="row">
                                    <label
                                        for="docuseal_webhook_secret"
                                        class="col-lg-4 o_light_label"
                                    />
                                    <field
                                        name="docuseal_webhook_secret"
                                        password="True"
                                    />
                                </div>
                            </div>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
