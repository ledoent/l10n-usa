<odoo>
    <record id="view_1099_generate_form" model="ir.ui.view">
        <field name="model">l10n.us.1099.generate</field>
        <field name="arch" type="xml">
            <form string="Generate 1099 Report">
                <group>
                    <field name="year" />
                    <field
                        name="company_id"
                        groups="base.group_multi_company"
                    />
                </group>
                <footer>
                    <button
                        name="action_generate"
                        type="object"
                        string="Generate"
                        class="btn-primary"
                    />
                    <button string="Cancel" class="btn-secondary" special="cancel" />
                </footer>
            </form>
        </field>
    </record>

    <record id="action_1099_generate" model="ir.actions.act_window">
        <field name="name">Generate 1099 Report</field>
        <field name="res_model">l10n.us.1099.generate</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
