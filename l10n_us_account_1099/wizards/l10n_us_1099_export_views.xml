<odoo>
    <record id="view_1099_export_form" model="ir.ui.view">
        <field name="model">l10n.us.1099.export</field>
        <field name="arch" type="xml">
            <form string="Export 1099 CSV">
                <group>
                    <field name="filename" invisible="1" />
                    <field name="data" filename="filename" readonly="1" />
                </group>
                <footer>
                    <button string="Close" class="btn-primary" special="cancel" />
                </footer>
            </form>
        </field>
    </record>
</odoo>
