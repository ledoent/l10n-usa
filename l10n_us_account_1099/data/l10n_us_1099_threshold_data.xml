    <!-- MISC Box 6 Medical: $600 -> $2,000 (2026) -->
    <record id="thr_misc_6_2020" model="l10n.us.1099.threshold">
        <field name="box_id" ref="box_misc_6" />
        <field name="date_from">2020-01-01</field>
        <field name="amount">600</field>
    </record>
    <record id="thr_misc_6_2026" model="l10n.us.1099.threshold">
        <field name="box_id" ref="box_misc_6" />
        <field name="date_from">2026-01-01</field>
        <field name="amount">2000</field>
    </record>
    <!-- MISC Box 10 Gross proceeds to attorney: $600 -> $2,000 (2026) -->
    <record id="thr_misc_10_2020" model="l10n.us.1099.threshold">
        <field name="box_id" ref="box_misc_10" />
