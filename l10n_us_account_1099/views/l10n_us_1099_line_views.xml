<odoo>
    <record id="view_1099_line_list" model="ir.ui.view">
        <field name="model">l10n.us.1099.line</field>
        <field name="arch" type="xml">
            <list create="false" decoration-muted="not reportable">
                <field name="year" />
                <field name="partner_id" />
                <field name="tin" optional="show" />
                <field name="form" />
                <field name="box_id" />
                <field name="amount" sum="Total" />
                <field name="threshold" optional="hide" />
                <field name="reportable" />
                <field name="w9_received" optional="hide" />
                <field name="company_id" groups="base.group_multi_company" />
            </list>
        </field>
    </record>

    <record id="view_1099_line_search" model="ir.ui.view">
        <field name="model">l10n.us.1099.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="partner_id" />
                <field name="year" />
                <filter
                    name="reportable"
                    string="Reportable"
                    domain="[('reportable', '=', True)]"
                />
                <filter
                    name="below_threshold"
                    string="Below Threshold"
                    domain="[('reportable', '=', False)]"
                />
                <group expand="0" string="Group By">
                    <filter
                        name="group_year"
                        string="Year"
                        context="{'group_by': 'year'}"
                    />
                    <filter
                        name="group_partner"
                        string="Payee"
                        context="{'group_by': 'partner_id'}"
                    />
                    <filter
                        name="group_form"
                        string="Form"
                        context="{'group_by': 'form'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <record id="action_1099_export_server" model="ir.actions.server">
        <field name="name">Export 1099 CSV</field>
        <field name="model_id" ref="model_l10n_us_1099_line" />
        <field name="binding_model_id" ref="model_l10n_us_1099_line" />
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">action = records.action_export_csv()</field>
    </record>

    <record id="action_1099_line" model="ir.actions.act_window">
        <field name="name">1099 Report Lines</field>
        <field name="res_model">l10n.us.1099.line</field>
        <field name="view_mode">list</field>
        <field name="search_view_id" ref="view_1099_line_search" />
        <field name="context">{'search_default_reportable': 1}</field>
    </record>
</odoo>
