<odoo noupdate="1">
    <!--
        Zift is not shipped in core `payment`, so unlike an in-tree provider
        there is no stub record to extend: the identity fields and the
        configuration are created together here.

        `module_id` is not decorative. It is what makes the Install/Activate
        button on the Payment Providers list and `_toggle_post_processing_cron`
        behave. `base.module_payment_zift` is created automatically by `base`
        for every installed module, so the ref resolves.

        `noupdate="1"` is mandatory. Without it, every `-u` would reset a live
        merchant's credentials and published state.
    -->
    <record id="payment_provider_zift" model="payment.provider">
        <field name="name">Zift</field>
        <field name="code">zift</field>
        <field
            name="image_128"
            type="bytes"
            file="payment_zift/static/description/icon.png"
        />
        <field name="module_id" ref="base.module_payment_zift" />
        <field name="inline_form_view_id" ref="inline_form" />
        <field name="allow_tokenization">True</field>
    </record>
</odoo>
