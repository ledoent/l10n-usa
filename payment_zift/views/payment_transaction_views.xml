<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="payment_transaction_form_fee" model="ir.ui.view">
        <field name="name">payment.transaction.form.zift.fee</field>
        <field name="model">payment.transaction</field>
        <field name="inherit_id" ref="payment.payment_transaction_form" />
        <field name="arch" type="xml">
            <field name="amount" position="after">
                <field
                    name="zift_fee_amount"
                    string="Gateway processing fee"
                    invisible="provider_code != 'zift'"
                />
                <field
                    name="zift_fee_accepted_at"
                    string="Fee accepted at"
                    invisible="provider_code != 'zift'"
                />
                <field
                    name="zift_fee_processed"
                    string="Quoted payment attempted"
                    invisible="provider_code != 'zift'"
                />
            </field>
        </field>
    </record>
    <template id="payment_status_fee" inherit_id="payment.payment_status">
        <xpath expr="//div[@name='o_payment_status']" position="inside">
            <div
                t-if="tx.provider_code == 'zift' and tx.zift_fee_accepted_at"
                class="alert alert-info mt-3"
                role="status"
            >
                <p>Accepted payment amount: <span
                    t-field="tx.zift_fee_principal"
                />.</p>
                <p>Gateway processing fee: <span t-field="tx.zift_fee_amount" />.</p>
                <p
                >You accepted these amounts. A bank debit is confirmed only after settlement.</p>
            </div>
        </xpath>
    </template>
</odoo>
