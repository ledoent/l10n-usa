<odoo>
    <record id="payment_provider_form" model="ir.ui.view">
        <field name="name">Zift Provider Form</field>
        <field name="model">payment.provider</field>
        <field name="inherit_id" ref="payment.payment_provider_form" />
        <field name="arch" type="xml">
            <group name="provider_credentials" position="inside">
                <field
                    string="User Name"
                    name="zift_username"
                    invisible="code != 'zift'"
                    required="is_live"
                />
                <field
                    string="Password"
                    name="zift_password"
                    widget="password"
                    invisible="code != 'zift'"
                    required="is_live"
                />
                <field
                    string="Account ID"
                    name="zift_account_id"
                    widget="password"
                    invisible="code != 'zift'"
                    required="is_live"
                />
            </group>
        </field>
    </record>
</odoo>
