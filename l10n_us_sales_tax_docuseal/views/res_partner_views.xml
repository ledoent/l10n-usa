<odoo>
    <record id="view_partner_form_exemption" model="ir.ui.view">
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form" />
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button
                    type="object"
                    name="action_view_exemption_certificates"
                    class="oe_stat_button"
                    icon="fa-certificate"
                >
                    <field
                        name="exemption_certificate_count"
                        widget="statinfo"
                        string="Exemptions"
                    />
                </button>
            </div>
        </field>
    </record>
</odoo>
